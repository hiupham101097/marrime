{
  "name": "marrime-wedding",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/node-server.ts",
    "build": "npm run build:client && npm run build:server && node scripts/postbuild.js",
    "build:client": "vite build",
    "build:server": "esbuild src/server/cloudflare-worker.ts --bundle --outfile=dist/worker.js --format=esm --target=es2022",
    "start": "tsx src/server/node-server.ts",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist --project-name=marrime",
    "deploy:pages": "wrangler pages deploy dist --project-name=marrime",
    "deploy:cloudflare": "wrangler pages deploy dist --project-name=wedding-invitation"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^3.111.0"
  }
}
